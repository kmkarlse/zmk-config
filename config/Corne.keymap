/*
 * Simple Corne keymap — Norwegian (Norsk) host layout, Windows.
 *
 * Layer 0 (BASE) — plain QWERTY. On Norwegian OS, the SEMI/SQT keys
 * produce ø/æ automatically, so home-row right gives you those for free.
 * Layer 1 (SYM)  — F-row, brackets, digits 9/0, backslash.
 * Layer 2 (NUM)  — number row + inverted-T arrow cluster on right hand.
 * Layer 3 (L3)   — placeholder, toggled by long-holding / for 2s.
 */

#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include "layout/corne.dtsi"
#include "os/shared/nordic.dtsi"   // NO_AE, NO_OE, NO_AA aliases

/ {
    chosen { zmk,physical-layout = &default_layout; };

    behaviors {
        // Tap = /, hold 1s = toggle target layer.
        // On layer 3 the same position is &trans, so it falls through to
        // this binding on BASE — another 1s hold toggles layer 3 back off.
    };

    keymap {
        compatible = "zmk,keymap";

        base_layer {
            display-name = "BASE";
            bindings = <
&kp ESC       &kp Q  &kp W  &kp E           &kp R     &kp T      &kp Y    &kp U  &kp I      &kp O    &kp P      &kp SLASH
&kp LEFT_GUI  &kp A  &kp S  &kp D           &kp F     &kp G      &kp H    &kp J  &kp K      &kp L    &kp SEMI   &kp SQT
&kp LCTRL     &kp Z  &kp X  &kp C           &kp V     &kp B      &kp N    &kp M  &kp COMMA  &kp DOT  &kp MINUS  &kp LEFT_ALT
                            &kp LEFT_SHIFT  &kp BSPC  &kp SPACE  &kp RET  &mo 1  &mo 2
            >;
        };

        sym_layer {
            display-name = "SYM";

            // Norwegian-Windows keycodes:
            //   { = RA(N7)   } = RA(N0)
            //   [ = RA(N8)   ] = RA(N9)
            //   \ = RA(NON_US_BSLH)   (AltGr + < on Norwegian ISO)

            bindings = <
&kp F1   &kp F2  &kp F3  &kp F4  &kp F5  &kp F6      &kp F7      &kp F8      &kp F9               &kp F10  &kp F11  &kp F12
&kp TAB  &trans  &trans  &trans  &trans  &trans      &kp RA(N7)  &kp RA(N0)  &kp N9               &kp N0   &trans   &trans
&trans   &trans  &trans  &trans  &trans  &bt BT_CLR  &kp RA(N8)  &kp RA(N9)  &kp RA(NON_US_BSLH)  &trans   &trans   &trans
                         &trans  &trans  &tog 3      &trans      &trans      &trans
            >;
        };

        num_layer {
            display-name = "NUM";

            // Right-hand inverted-T arrow cluster on K/J,K,L (cols 7,8,9):
            //          UP
            //   LEFT  DOWN  RIGHT

            bindings = <
&trans  &kp TAB     &kp PAGE_UP     &kp UP_ARROW    &kp PAGE_DOWN    &kp N5  &trans  &trans  &kp NUMBER_7  &kp NUMBER_8  &kp NUMBER_9  &trans
&trans  &trans      &kp LEFT_ARROW  &kp DOWN_ARROW  &kp RIGHT_ARROW  &trans  &trans  &trans  &kp NUMBER_4  &kp NUMBER_5  &kp NUMBER_6  &kp NUMBER_0
&trans  &kp K_UNDO  &kp K_CUT       &kp K_COPY      &kp K_PASTE      &trans  &trans  &trans  &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &trans
                                    &trans          &trans           &trans  &trans  &trans  &trans
            >;
        };

        layer_3 {
            display-name = "L3";

            // Placeholder. / position is &trans so 2s hold falls through
            // to BASE's &fslh_lock and toggles this layer back off.

            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &kp LEFT_BRACKET
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
                        &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };
    };
};
