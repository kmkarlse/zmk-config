/*
 * Simple Corne keymap — Norwegian (Norsk) host layout, Windows.
 *
 * Layer 0 (BASE) — plain QWERTY. On Norwegian OS, the SEMI/SQT keys
 * produce ø/æ automatically, so home-row right gives you those for free.
 * Layer 1 (SYM)  — F-row, brackets, digits 9/0, backslash.
 * Layer 2 (NUM)  — number row + inverted-T arrow cluster on right hand.
 */

#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>

#include "layout/corne.dtsi"
#include "os/shared/nordic.dtsi"   // NO_AE, NO_OE, NO_AA aliases

/ {
    chosen {
        zmk,physical-layout = &default_layout;
    };

    keymap {
        compatible = "zmk,keymap";

        base_layer {
            display-name = "BASE";
            bindings = <
&kp ESC    &kp Q  &kp W  &kp E     &kp R     &kp T          &kp Y     &kp U  &kp I      &kp O    &kp P      &kp FSLH
&kp LSHFT  &kp A  &kp S  &kp D     &kp F     &kp G          &kp H     &kp J  &kp K      &kp L    &kp SEMI   &kp SQT
&kp LCTRL  &kp Z  &kp X  &kp C     &kp V     &kp B          &kp N     &kp M  &kp COMMA  &kp DOT  &kp MINUS  &kp RALT
                         &kp LGUI  &kp BSPC  &kp SPACE      &kp RET   &mo 1  &mo 2
            >;
        };

        sym_layer {
            display-name = "SYM";
            // Norwegian-Windows keycodes:
            //   { = RA(N7)   } = RA(N0)
            //   [ = RA(N8)   ] = RA(N9)
            //   \ = RA(NON_US_BSLH)   (AltGr + < on Norwegian ISO)
            bindings = <
&kp F1   &kp F2  &kp F3  &kp F4  &kp F5  &kp F6         &kp F7      &kp F8      &kp F9               &kp F10  &kp F11  &kp F12
&kp TAB  &trans  &trans  &trans  &trans  &trans         &kp RA(N7)  &kp RA(N0)  &kp N9               &kp N0   &trans   &trans
&trans   &trans  &trans  &trans  &trans  &trans         &kp RA(N8)  &kp RA(N9)  &kp RA(NON_US_BSLH)  &trans   &trans   &trans
                         &trans  &trans  &trans         &trans      &trans      &trans
            >;
        };

        num_layer {
            display-name = "NUM";
            // Right-hand inverted-T arrow cluster on K/J,K,L (cols 7,8,9):
            //          UP
            //   LEFT  DOWN  RIGHT
            bindings = <
&trans  &kp N1  &kp N2  &kp N3  &kp N4  &kp N5         &kp N6    &kp N7      &kp N8    &kp N9       &kp N0  &trans
&trans  &trans  &trans  &trans  &trans  &trans         &trans    &trans      &kp UP    &trans       &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans         &trans    &kp LEFT    &kp DOWN  &kp RIGHT    &trans  &trans
                        &trans  &trans  &trans         &trans    &trans      &trans
            >;
        };
    };
};
