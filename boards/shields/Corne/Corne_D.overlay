/*
 * Corne dongle — a third nRF52840 ProMicro acting as the sole BLE
 * central. Both keyboard halves are peripherals; this board has no
 * keys, no LEDs and no OLED. It relays the host link over USB and maps
 * key positions from both halves into the shared config/Corne.keymap.
 *
 * (ZMK strips the `_D` suffix, so this shield reuses Corne.keymap and
 * config/Corne.conf automatically — no per-dongle keymap file needed.)
 */
#include <dt-bindings/zmk/matrix_transform.h>
#include "Corne-layouts.dtsi"

/ {
	chosen {
		/* No display, no underglow on the dongle. */
		zmk,kscan = &kscan0;
		zmk,physical-layout = &layout_0;
	};

	behaviors {
		/* Same global RGB behavior as the halves. The dongle has no
		 * strip, so its local invocation is a no-op (compiled out via
		 * the CONFIG_WS2812_STRIP guard in behavior_rgb_reactive.c) —
		 * but the node MUST exist here so layer_color.c can fire it and
		 * have ZMK forward it to BOTH peripherals over split BLE. Keep
		 * the label ≤8 chars (split behavior_dev wire limit). */
		rgb_reactive: behavior_rgb_reactive {
			compatible = "zmk,behavior-rgb-reactive";
			#binding-cells = <2>;
			label = "rgb_rx";
			display-name = "RGB Reactive";
		};
	};

	/* Full 42-key transform so positions from both halves land in
	 * range. Identical to the halves' default_transform — do NOT add
	 * offsets here: the central applies each peripheral's position
	 * as-is, and the halves already bake their global positions in
	 * (left col-offset 0, right col-offset 6). */
	default_transform: keymap_transform_0 {
		compatible = "zmk,matrix-transform";
		columns = <12>;
		rows = <4>;
		map = <
RC(0,0) RC(0,1) RC(0,2) RC(0,3) RC(0,4) RC(0,5)  RC(0,6)  RC(0,7) RC(0,8) RC(0,9) RC(0,10) RC(0,11)
RC(1,0) RC(1,1) RC(1,2) RC(1,3) RC(1,4) RC(1,5)  RC(1,6)  RC(1,7) RC(1,8) RC(1,9) RC(1,10) RC(1,11)
RC(2,0) RC(2,1) RC(2,2) RC(2,3) RC(2,4) RC(2,5)  RC(2,6)  RC(2,7) RC(2,8) RC(2,9) RC(2,10) RC(2,11)
                        RC(3,3) RC(3,4) RC(3,5)  RC(3,6) RC(3,7) RC(3,8)
		>;
	};

	/* No physical matrix on the dongle — a mock kscan satisfies the
	 * required zmk,kscan chosen node and emits nothing. */
	kscan0: kscan {
		compatible = "zmk,kscan-mock";
		columns = <0>;
		rows = <0>;
		events = <0>;
	};
};
